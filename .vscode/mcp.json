{
  "inputs": [
    {
      "type": "promptString",
      "id": "figma-key",
      "description": "Figma Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp@0.13.2",
        "--figma-api-key=${input:figma-key}",
        "--stdio"
      ]
    },
    "figma-local": {
      "command": "node",
      "args": [
        "${workspaceFolder}/vendor/figma-context-mcp/dist/bin.js",
        "--figma-api-key=${input:figma-key}",
        "--stdio"
      ]
    }
  }
}
